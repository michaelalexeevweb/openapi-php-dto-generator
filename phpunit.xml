<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         cacheDirectory=".phpunit.cache">
    <php>
        <!-- The full suite peaks just above PHP's default 128M; pinned so a plain `vendor/bin/phpunit`
             behaves the same on every machine and in CI. -->
        <ini name="memory_limit" value="512M"/>
    </php>
    <testsuites>
        <testsuite name="OpenAPI Generator Test Suite">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <!-- `failOnDeprecation` judges OUR code: a deprecation raised inside vendor (an old transitive
         package on the lowest-dependency job) is the dependency's business, not a failure here. -->
    <source restrictDeprecations="true">
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>

