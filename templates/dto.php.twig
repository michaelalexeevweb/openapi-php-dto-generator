        return parent::getParameterAllowEmptyValue();
{% else %}
        return [];
{% endif %}
{% else %}
{% if extends is not null %}
        $allowEmptyValue = parent::getParameterAllowEmptyValue();
{% else %}
        $allowEmptyValue = [];
{% endif %}
{% for assignment in parameterAllowEmptyValueAssignments %}
        $allowEmptyValue['{{ assignment.name }}'] = {{ assignment.allowEmptyValue ? 'true' : 'false' }};
{% endfor %}

        return $allowEmptyValue;
{% endif %}
    }
}
{% endif %}
