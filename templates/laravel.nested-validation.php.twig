{% if selfReachable %}
    /**
     * Rule sets joined path by path: two sets that name one path both apply. A plain merge kept the
     * later one only — the rule that checks a self-referring level (`openApiRecursiveRule()`) replaced
     * the `array` and presence rules written for the same path.
     *
     * @param array<string, array<int, mixed>> ...$sets
     * @return array<string, array<int, mixed>>
     */
    private static function openApiMergedRules(array ...$sets): array
    {
        $merged = [];
        foreach ($sets as $set) {
            foreach ($set as $path => $rules) {
                $merged[$path] = [...($merged[$path] ?? []), ...$rules];
            }
        }

        return $merged;
    }

{% endif %}
{% if nestedChildren is not empty %}
    /**
     * What the nested DTOs below this class's properties add to its validation — their dotted rules and
     * the paths whose wire shape is checked — asked of each nested class rather than written out here.
     *
     * @return array{rules: array<string, array<int, mixed>>, objectPaths: array<int, string>, scalarPaths: array<string, string>}
     */
    private static function openApiNestedParts(): array
    {
        $parts = [
{% for child in nestedChildren %}
            {{ child.ref }}::openApiNestedValidation('{{ child.suffix|php_string }}', [self::class]),
{% endfor %}
        ];

        return [
{% if selfReachable %}
            'rules' => self::openApiMergedRules(...array_column($parts, 'rules')),
{% else %}
            'rules' => array_merge(...array_column($parts, 'rules')),
{% endif %}
            'objectPaths' => array_merge(...array_column($parts, 'objectPaths')),
            'scalarPaths' => array_merge(...array_column($parts, 'scalarPaths')),
        ];
    }

{% if selfReachable %}
    /**
     * The rule that checks a value holding this class where the schema refers back to itself — see
     * `openApiNestedValidation()`: this class's rules, run on the value, every problem reported at its
     * path. A value that is no array is left to the `array` rule beside it.
     *
     * @internal
     */
    private static function openApiRecursiveRule(): \Illuminate\Contracts\Validation\ValidationRule
    {
        return new class implements \Illuminate\Contracts\Validation\ValidationRule, \Illuminate\Contracts\Validation\ValidatorAwareRule {
            private ?\Illuminate\Validation\Validator $validator = null;

            public function setValidator(\Illuminate\Validation\Validator $validator): static
            {
                $this->validator = $validator;

                return $this;
            }

            public function validate(string $attribute, mixed $value, \Closure $fail): void
            {
                if (!is_array($value) || $this->validator === null) {
                    return;
                }
                $nested = new \Illuminate\Validation\Validator(
                    translator: $this->validator->getTranslator(),
                    data: $value,
                    rules: self::ownRules(),
                );
                foreach ($nested->errors()->messages() as $key => $messages) {
                    foreach ($messages as $message) {
                        $fail($attribute . '.' . $key . ': ' . $message);
                    }
                }
            }

            /** @return array<string, mixed> */
            private static function ownRules(): array
            {
                return {{ className }}::rules();
            }
        };
    }

{% endif %}
{% endif %}
{% if nestedValidation is not null %}
    /**
     * What this class adds to the validation of a payload that holds it at `$prefix`: its dotted rules —
     * presence left out, no rule can say "required only if the parent has a value" — and the paths whose
     * wire shape is checked against the raw body. A parent asks for it instead of repeating it under
     * every path that reaches this class.
     *
     * @internal called by the generated classes that hold this one
     * @param array<int, string> $visited the classes above this one; one already among them adds nothing
     * @return array{rules: array<string, array<int, mixed>>, objectPaths: array<int, string>, scalarPaths: array<string, string>}
     */
    public static function openApiNestedValidation(string $prefix, array $visited): array
    {
{% if selfReachable %}
        // The schema holds itself below this point. The rules cannot be written out to every depth, so
        // the level here is checked as the data reaches it: with this class's own rules, which do the
        // same one level further down. Stopping here, as this did, left everything below unchecked,
        // and a wrong value there reached hydration and failed with a 500 instead of a 422.
{% endif %}
        if (in_array(self::class, $visited, true)) {
{% if selfReachable %}
            return ['rules' => [$prefix => [self::openApiRecursiveRule()]], 'objectPaths' => [], 'scalarPaths' => []];
{% else %}
            return ['rules' => [], 'objectPaths' => [], 'scalarPaths' => []];
{% endif %}
        }
        $visited[] = self::class;

        $parts = [
            [
                'rules' => [
{% for rule in nestedValidation.rules %}
                    $prefix . '.{{ rule.suffix|php_string }}' => {{ rule.rules|raw }},
{% endfor %}
                ],
                'objectPaths' => [
{% for objectPath in nestedValidation.objectPaths %}
                    $prefix . '.{{ objectPath|php_string }}',
{% endfor %}
                ],
                'scalarPaths' => [
{% for scalarPath, scalarType in nestedValidation.scalarPaths %}
                    $prefix . '.{{ scalarPath|php_string }}' => '{{ scalarType|php_string }}',
{% endfor %}
                ],
            ],
{% for child in nestedValidation.children %}
            {{ child.ref }}::openApiNestedValidation($prefix . '.{{ child.suffix|php_string }}', $visited),
{% endfor %}
        ];

        return [
{% if selfReachable %}
            'rules' => self::openApiMergedRules(...array_column($parts, 'rules')),
{% else %}
            'rules' => array_merge(...array_column($parts, 'rules')),
{% endif %}
            'objectPaths' => array_merge(...array_column($parts, 'objectPaths')),
            'scalarPaths' => array_merge(...array_column($parts, 'scalarPaths')),
        ];
    }

{% endif %}
