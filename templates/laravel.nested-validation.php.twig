{% if selfReachable %}
    /**
     * Rule sets joined path by path: two sets that name one path both apply. A plain merge kept the
     * later one only — the rule that checks a self-referring level (`openApiRecursiveRule()`) replaced
     * the `array` and presence rules written for the same path.
     *
     * @param array<string, array<int, mixed>> ...$sets
     * @return array<string, array<int, mixed>>
     */
    private static function openApiMergedRules(array ...$sets): array
    {
        $merged = [];
        foreach ($sets as $set) {
            foreach ($set as $path => $rules) {
                $merged[$path] = [...($merged[$path] ?? []), ...$rules];
            }
        }

        return $merged;
    }

{% endif %}
{% if nestedChildren is not empty %}
    /**
     * What the nested DTOs below this class's properties add to its validation — their dotted rules and
     * the paths whose wire shape is checked — asked of each nested class rather than written out here.
     *
{% if reachesRecursion %}
     * @return array{rules: array<string, array<int, mixed>>, objectPaths: array<int, string>, scalarPaths: array<string, string>, recursions: array<string, class-string>}
{% else %}
     * @return array{rules: array<string, array<int, mixed>>, objectPaths: array<int, string>, scalarPaths: array<string, string>}
{% endif %}
     */
    private static function openApiNestedParts(): array
    {
        $parts = [
{% for child in nestedChildren %}
            {{ child.ref }}::openApiNestedValidation('{{ child.suffix|php_string }}', [self::class]),
{% endfor %}
        ];

        return [
{% if selfReachable %}
            'rules' => self::openApiMergedRules(...array_column($parts, 'rules')),
{% else %}
            'rules' => array_merge(...array_column($parts, 'rules')),
{% endif %}
            'objectPaths' => array_merge(...array_column($parts, 'objectPaths')),
            'scalarPaths' => array_merge(...array_column($parts, 'scalarPaths')),
{% if reachesRecursion %}
            'recursions' => array_merge(...array_column($parts, 'recursions')),
{% endif %}
        ];
    }

{% if reachesRecursion %}
    /**
     * The wire-shape paths below the levels where the schema refers back to itself, as deep as the raw
     * body goes. Written out they would never end, so each such level the payload actually reaches is
     * asked for its own paths, and names the levels below it in turn. Without this the `type: object`
     * check stopped at the first self-referring level: `{"next": {"meta": [1]}}` was accepted where
     * `{"meta": [1]}` was refused.
     *
{% if collectsFreeFormPaths|default(false) %}
     * @return array{objectPaths: array<int, string>, scalarPaths: array<string, string>, freeFormPaths: array<int, string>}
{% else %}
     * @return array{objectPaths: array<int, string>, scalarPaths: array<string, string>}
{% endif %}
     */
    private static function openApiRecursivePaths(\stdClass $decoded): array
    {
        $objectPaths = [];
        $scalarPaths = [];
{% if collectsFreeFormPaths|default(false) %}
        $freeFormPaths = [];
{% endif %}
        $pending = self::openApiNestedParts()['recursions'];
        while ($pending !== []) {
            $prefix = (string)array_key_first($pending);
            $class = $pending[$prefix];
            $pending = array_slice($pending, 1, preserve_keys: true);
            // `\.` is a dot INSIDE a property name, as in `rules()`: it splits nothing.
            if (self::rawNodesAt($decoded, str_replace('\\.', '.', preg_split('/(?<!\\\\)\\./', $prefix) ?: []), '') === []) {
                continue;
            }
            $level = $class::openApiNestedValidation($prefix, []);
            $objectPaths = [...$objectPaths, ...$level['objectPaths']];
            $scalarPaths = [...$scalarPaths, ...$level['scalarPaths']];
{% if collectsFreeFormPaths|default(false) %}
            $freeFormPaths = [...$freeFormPaths, ...($level['freeFormPaths'] ?? [])];
{% endif %}
            $pending = [...$pending, ...($level['recursions'] ?? [])];
        }

{% if collectsFreeFormPaths|default(false) %}
        return ['objectPaths' => $objectPaths, 'scalarPaths' => $scalarPaths, 'freeFormPaths' => $freeFormPaths];
{% else %}
        return ['objectPaths' => $objectPaths, 'scalarPaths' => $scalarPaths];
{% endif %}
    }

{% endif %}
{% if selfReachable %}
    /**
     * The rule that checks a value holding this class where the schema refers back to itself — see
     * `openApiNestedValidation()`: this class's rules, written under the path the value sits at and run
     * on the payload, so every problem is reported once, under the field it is about, as any other rule
     * reports it. A value that is no array is left to the `array` rule beside it.
     *
     * Run on the value alone, as this was, the inner messages came back folded into one error on the
     * outer key — `child: child.child: validation.array` instead of an error at `child.child.child` —
     * and a violation the interpreter also saw was reported twice.
     *
     * @internal
     */
    private static function openApiRecursiveRule(): \Illuminate\Contracts\Validation\ValidationRule
    {
        return new class implements \Illuminate\Contracts\Validation\ValidationRule, \Illuminate\Contracts\Validation\ValidatorAwareRule {
            private ?\Illuminate\Validation\Validator $validator = null;

            public function setValidator(\Illuminate\Validation\Validator $validator): static
            {
                $this->validator = $validator;

                return $this;
            }

            public function validate(string $attribute, mixed $value, \Closure $fail): void
            {
                if (!is_array($value) || $this->validator === null) {
                    return;
                }
                $rules = [];
                foreach (self::ownRules() as $path => $pathRules) {
                    $rules[$attribute . '.' . $path] = $pathRules;
                }
                $nested = new \Illuminate\Validation\Validator(
                    translator: $this->validator->getTranslator(),
                    data: (fn(): array => $this->replacePlaceholders($this->getData()))->call($this->validator),
                    rules: $rules,
                );
                foreach ($nested->errors()->messages() as $key => $messages) {
                    foreach ($messages as $message) {
                        $this->validator->errors()->add($key, $message);
                    }
                }
            }

            /** @return array<string, mixed> */
            private static function ownRules(): array
            {
                return {{ className }}::rules();
            }
        };
    }

{% endif %}
{% endif %}
{% if nestedValidation is not null %}
    /**
     * What this class adds to the validation of a payload that holds it at `$prefix`: its dotted rules —
     * presence left out, no rule can say "required only if the parent has a value" — and the paths whose
     * wire shape is checked against the raw body. A parent asks for it instead of repeating it under
     * every path that reaches this class.
     *
     * @internal called by the generated classes that hold this one
     * @param array<int, string> $visited the classes above this one; one already among them adds nothing
{% if reachesRecursion and collectsFreeFormPaths|default(false) %}
     *   but the path where the payload re-enters it, in `recursions`
     * @return array{rules: array<string, array<int, mixed>>, objectPaths: array<int, string>, scalarPaths: array<string, string>, recursions: array<string, class-string>, freeFormPaths: array<int, string>}
{% elseif reachesRecursion %}
     *   but the path where the payload re-enters it, in `recursions`
     * @return array{rules: array<string, array<int, mixed>>, objectPaths: array<int, string>, scalarPaths: array<string, string>, recursions: array<string, class-string>}
{% else %}
     * @return array{rules: array<string, array<int, mixed>>, objectPaths: array<int, string>, scalarPaths: array<string, string>}
{% endif %}
     */
    public static function openApiNestedValidation(string $prefix, array $visited): array
    {
{% if selfReachable %}
        // The schema holds itself below this point. The rules cannot be written out to every depth, so
        // the level here is checked as the data reaches it: with this class's own rules, which do the
        // same one level further down. Stopping here, as this did, left everything below unchecked,
        // and a wrong value there reached hydration and failed with a 500 instead of a 422.
{% endif %}
        if (in_array(self::class, $visited, true)) {
{% if selfReachable %}
            return [
                'rules' => [$prefix => [self::openApiRecursiveRule()]],
                'objectPaths' => [],
                'scalarPaths' => [],
                'recursions' => [$prefix => self::class],
{% if collectsFreeFormPaths|default(false) %}
                'freeFormPaths' => [],
{% endif %}
            ];
{% else %}
            return ['rules' => [], 'objectPaths' => [], 'scalarPaths' => []];
{% endif %}
        }
        $visited[] = self::class;

        $parts = [
            [
                'rules' => [
{% for rule in nestedValidation.rules %}
                    $prefix . '.{{ rule.suffix|php_string }}' => {{ rule.rules|raw }},
{% endfor %}
                ],
                'objectPaths' => [
{% for objectPath in nestedValidation.objectPaths %}
                    $prefix . '.{{ objectPath|php_string }}',
{% endfor %}
                ],
                'scalarPaths' => [
{% for scalarPath, scalarType in nestedValidation.scalarPaths %}
                    $prefix . '.{{ scalarPath|php_string }}' => '{{ scalarType|php_string }}',
{% endfor %}
                ],
{% if reachesRecursion and collectsFreeFormPaths|default(false) %}
                // This class's own paths reach through the classes below it already; theirs would repeat them.
                'freeFormPaths' => [
{% for freeFormPath in nestedValidation.freeFormPaths %}
                    $prefix . '.{{ freeFormPath|php_string }}',
{% endfor %}
                ],
{% endif %}
            ],
{% for child in nestedValidation.children %}
            {{ child.ref }}::openApiNestedValidation($prefix . '.{{ child.suffix|php_string }}', $visited),
{% endfor %}
        ];

        return [
{% if selfReachable %}
            'rules' => self::openApiMergedRules(...array_column($parts, 'rules')),
{% else %}
            'rules' => array_merge(...array_column($parts, 'rules')),
{% endif %}
            'objectPaths' => array_merge(...array_column($parts, 'objectPaths')),
            'scalarPaths' => array_merge(...array_column($parts, 'scalarPaths')),
{% if reachesRecursion %}
            'recursions' => array_merge(...array_column($parts, 'recursions')),
{% endif %}
{% if reachesRecursion and collectsFreeFormPaths|default(false) %}
            'freeFormPaths' => $parts[0]['freeFormPaths'],
{% endif %}
        ];
    }

{% endif %}
